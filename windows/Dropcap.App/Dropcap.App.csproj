<Project Sdk="Microsoft.NET.Sdk">

  <!-- 윈도우 앱 본체: WinUI 3(XAML 파일 없이 코드로만) · 패키지 없는 실행 · 자체 포함.
       윈도우에서: dotnet publish -c Release -r win-x64 (README 참고)
       맥에서 C# 점검만: scripts/check-on-mac.sh (윈도우 전용 도구 단계를 끄고 컴파일까지) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Dropcap.App</RootNamespace>
    <AssemblyName>Dropcap</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Dropcap</Product>
    <Version>1.0.0</Version>
    <!-- 트리밍은 COM 연동(공유 창)과 WinRT 투영을 깨뜨릴 수 있어 끈다 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- 맥에서 C# 점검만 할 때(DropcapMacCheck=true): 윈도우 전용 실행 파일(mt.exe·MakePri.exe)을 쓰는 단계를 끈다 -->
  <PropertyGroup Condition="'$(DropcapMacCheck)' == 'true'">
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\Dropcap.Core\Dropcap.Core.csproj" />
    <ProjectReference Include="..\Dropcap.Ui\Dropcap.Ui.csproj" />
  </ItemGroup>

  <!-- 실행 파일 아이콘(D-03): 빌드 때 코드로 그려 obj 에 만든다(생성물은 저장소에 넣지 않음). 윈도우 빌드에서만. -->
  <Target Name="DropcapIcon" BeforeTargets="CoreCompile;PrepareForBuild" Condition="'$(DropcapMacCheck)' != 'true' And '$(OS)' == 'Windows_NT'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\tools\IconGen\IconGen.csproj&quot; -c Release -- &quot;$(BaseIntermediateOutputPath)app.ico&quot;" />
    <PropertyGroup>
      <ApplicationIcon>$(BaseIntermediateOutputPath)app.ico</ApplicationIcon>
    </PropertyGroup>
  </Target>

</Project>
